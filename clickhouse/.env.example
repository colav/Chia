# Copiar a .env y ajustar antes de desplegar. .env NO debe subirse a git,
# igual que en mongodb/ y ollama/.

CLICKHOUSE_VERSION=24.3
CLICKHOUSE_CONTAINER_NAME=clickhouse
CLICKHOUSE_DB=theme_curation
CLICKHOUSE_USER=colav
CLICKHOUSE_PASSWORD=changeme

# Puerto en el HOST (127.0.0.1) al que se mapea el 8123 del contenedor.
CLICKHOUSE_PORT=8123

# Límites de recursos — placeholder, mismo patrón que MONGO_CPUS/MONGO_RAM.
# Ajustar con las specs reales del servidor antes de producción.
CLICKHOUSE_CPUS=4
CLICKHOUSE_RAM=8G
